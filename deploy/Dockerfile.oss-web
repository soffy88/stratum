FROM node:22-bookworm-slim AS build

# Match the repository's release CI toolchain. The lockfile is v9 and the
# private Helios packages are vendored local tarballs.
RUN corepack enable && corepack prepare pnpm@10.12.4 --activate
ENV COREPACK_ENABLE_PROJECT_SPEC=0
WORKDIR /app

COPY aii-web/package.json aii-web/pnpm-lock.yaml aii-web/.npmrc ./
COPY aii-web/vendor ./vendor
RUN pnpm install --frozen-lockfile

COPY aii-web/ ./
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV STRATUM_API_BASE=http://api:9302
ENV STRATUM_SL_BASE=http://api:9302
RUN pnpm build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
