# Copy to deploy/.env for the local OSS Compose deployment.
# Never commit deploy/.env or replace these placeholders with real credentials.
AII_DB_NAME=aii_kg
AII_DB_USER=aii
AII_DB_PASSWORD=change-me-before-start-please-rotate
JWT_SECRET=change-me-before-start-please-rotate-this-secret
COOKIE_SECRET=change-me-before-start-please-rotate-this-cookie
ADMIN_SECRET=change-me-before-start-please-rotate-this-admin
AII_PUBLIC_ORIGIN=http://127.0.0.1:9302
AII_WEB_PORT=3000
STRATUM_CORS_ALLOWED_ORIGINS=http://127.0.0.1:9302
EMBEDDING_PROVIDER=disabled
VISUAL_BACKEND=disabled
