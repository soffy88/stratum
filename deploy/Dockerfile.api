FROM python:3.14-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY src/ /app/src/
COPY pyproject.toml /app/

RUN pip install --no-cache-dir fastapi uvicorn duckdb psycopg2-binary argon2-cffi pyjwt python-ulid pydantic[email] structlog mcp fastmcp pyyaml numpy chardet httpx scipy pandas scikit-learn statsmodels redis apscheduler python-magic dnspython fsrs psutil rapidfuzz cryptography asyncpg pydantic-settings python-multipart python-frontmatter alembic tenacity bcrypt pyotp paramiko defusedxml jinja2

ENV PYTHONPATH=/app/src
EXPOSE 9302

CMD ["uvicorn", "stratum.http_api.app:app", "--host", "0.0.0.0", "--port", "9302"]
