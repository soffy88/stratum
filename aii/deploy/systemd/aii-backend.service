[Unit]
Description=AII epistemic backend (uvicorn :8101)
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/soffy/projects/stratum/aii/aii
# 嵌入走共享 aii-embed 微服务(按需加载/空闲卸载) → aii-backend 自身 0 常驻 BGE-M3, 不占 2.2G RAM/不碰 GPU
# ★aii-embed 已迁到笔记本GTX1050Ti(禁止用本机GPU), 走tailscale: 100.119.113.90(笔记本Windows主机自己的tailscale身份, 原生跑不经WSL)
# ★2026-10 嵌入统一到 EmbeddingGemma2(笔记本 EG2 服务, 768 维, OpenAI 兼容 /v1)
Environment=AII_EMBED_BACKEND=eg2
Environment=AII_EMBED_BASE_URL=http://100.68.226.13:8790/v1
# 仅 AII_EMBED_BACKEND=bge 回滚时使用(旧 BGE-M3 aii-embed 服务)
Environment=AII_EMBED_URL=http://100.119.113.90:8102
ExecStart=/home/soffy/.local/bin/uv run --project /data/soffy/projects/stratum/aii uvicorn aii.api.app:app --host 0.0.0.0 --port 8101
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
