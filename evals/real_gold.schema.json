{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AII human-reviewed evaluation record",
  "type": "object",
  "required": ["query_id", "layer", "owner_id", "source_ids", "provenance", "expected_output"],
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "layer": {"enum": ["ingestion", "fragmentation", "evidence_extraction", "claim_correctness", "citation_completeness", "concept_normalization", "relation_accuracy", "retrieval", "answer_grounding"]},
    "owner_id": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "object", "minProperties": 1},
    "expected_output": {},
    "gold_origin": {"const": "human_reviewed"},
    "synthetic_only": {"not": {"const": true}}
  },
  "additionalProperties": true
}
